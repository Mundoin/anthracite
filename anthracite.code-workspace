{
  "folders": [
    {
      "name": "Anthracite V1",
      "path": "D:\\Repos\\anthracite"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "D:\\Repos\\anthracite\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.cwd": "D:\\Repos\\anthracite",
    "git.autofetch": true,
    "restoreTerminals.runOnStartup": true,
    "restoreTerminals.keepExistingTerminalsOpen": false,
    "restoreTerminals.artificialDelayMilliseconds": 1000,
    "files.exclude": {
      "**/.venv": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/src-tauri/target": true,
      "**/graphify-out": true,
      "**/.pytest_cache": true,
      "**/__pycache__": true,
      "**/*.pyc": true
    },
    "search.exclude": {
      "**/.venv": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/src-tauri/target": true,
      "**/graphify-out": true,
      "**/.pytest_cache": true,
      "**/__pycache__": true,
      "**/*.pyc": true
    },
    "restoreTerminals.terminals": [
      {
        "splitTerminals": [
          {
            "name": "Anthracite — APP RUNNER",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "& 'D:\\Repos\\anthracite\\.venv\\Scripts\\Activate.ps1'",
              "powershell -ExecutionPolicy Bypass -File .\\tools\\workspace-status.ps1",
              "powershell -ExecutionPolicy Bypass -File .\\tools\\graphify-freshness.ps1",
              "Write-Host 'App runner ready. Start manually with: pnpm tauri:dev'"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "Anthracite — AO DAEMON",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "& 'D:\\Repos\\anthracite\\.venv\\Scripts\\Activate.ps1'",
              "Write-Host 'Starting AgentOps daemon at http://127.0.0.1:8765'",
              "ao daemon run --addr 127.0.0.1:8765 --executor-policy fake"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "Anthracite — CLAUDE CODE",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "& 'D:\\Repos\\anthracite\\.venv\\Scripts\\Activate.ps1'",
              "powershell -ExecutionPolicy Bypass -File .\\tools\\workspace-status.ps1",
              "Write-Host 'Claude terminal ready. Start manually with: claude'"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "Anthracite — CODEX ADMIN",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "& 'D:\\Repos\\anthracite\\.venv\\Scripts\\Activate.ps1'",
              "powershell -ExecutionPolicy Bypass -File .\\tools\\workspace-status.ps1",
              "Write-Host 'Codex terminal ready. Start manually with: codex'"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "Anthracite — DEEPSEEK CLI",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "& 'D:\\Repos\\anthracite\\.venv\\Scripts\\Activate.ps1'",
              "powershell -ExecutionPolicy Bypass -File .\\tools\\workspace-status.ps1",
              "Write-Host 'DeepSeek terminal ready. Start manually with your DeepSeek CLI command.'"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "Anthracite — GITHUB / GIT ADMIN",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "& 'D:\\Repos\\anthracite\\.venv\\Scripts\\Activate.ps1'",
              "git status --short",
              "gh --version",
              "Write-Host 'GitHub/Git admin terminal ready. Run git/gh commands manually.'"
            ]
          }
        ]
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.powershell",
      "rust-lang.rust-analyzer",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "eamodio.gitlens",
      "github.vscode-github-actions",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ericsia.restoreterminals"
