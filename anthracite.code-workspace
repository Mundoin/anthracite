{
  "folders": [
    {
      "name": "Anthracite V1",
      "path": "D:\\Repos\\anthracite"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "D:\\Repos\\anthracite\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.cwd": "D:\\Repos\\anthracite",
    "git.autofetch": true,
    "restoreTerminals.runOnStartup": true,
    "restoreTerminals.keepExistingTerminalsOpen": false,
    "restoreTerminals.artificialDelayMilliseconds": 1000,
    "files.exclude": {
      "**/.venv": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/src-tauri/target": true,
      "**/graphify-out": true,
      "**/.pytest_cache": true,
      "**/__pycache__": true,
      "**/*.pyc": true
    },
    "search.exclude": {
      "**/.venv": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/src-tauri/target": true,
      "**/graphify-out": true,
      "**/.pytest_cache": true,
      "**/__pycache__": true,
      "**/*.pyc": true
    },
    "restoreTerminals.terminals": [
      {
        "splitTerminals": [
          {
            "name": "Anthracite - App / Git",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "& 'D:\\Repos\\anthracite\\.venv\\Scripts\\Activate.ps1'",
              "powershell -ExecutionPolicy Bypass -File .\\tools\\workspace-status.ps1",
              "powershell -ExecutionPolicy Bypass -File .\\tools\\graphify-freshness.ps1",
              "Write-Host 'Repo ready. Dev: pnpm tauri:dev'"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "Anthracite - AO Daemon",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "& 'D:\\Repos\\anthracite\\.venv\\Scripts\\Activate.ps1'",
              "Write-Host 'Starting AgentOps daemon at http://127.0.0.1:8765'",
              "ao daemon run --addr 127.0.0.1:8765 --executor-policy fake"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "Anthracite - Start Lean",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tools\\opencode\\start-anthracite-lean-hidden.ps1"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "Anthracite - Service Status",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tools\\opencode\\status-anthracite-opencode.ps1"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "Anthracite - OpenCode Lean",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "Write-Host 'Lean OpenCode: cheap/no OMO'",
              "Write-Host '.\\tools\\opencode\\attach-anthracite-lean.ps1'"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "Anthracite - OpenCode OMO",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "Write-Host 'OMO OpenCode: heavy/server-side OMO routing'",
              "Write-Host '.\\tools\\opencode\\attach-anthracite-omo.ps1'"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "Anthracite - Codex / Claude",
            "commands": [
              "Set-Location 'D:\\Repos\\anthracite'",
              "& 'D:\\Repos\\anthracite\\.venv\\Scripts\\Activate.ps1'",
              "powershell -ExecutionPolicy Bypass -File .\\tools\\workspace-status.ps1",
              "Write-Host 'Codex/Claude ready. Start manually: codex or claude'"
            ]
          }
        ]
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.powershell",
      "rust-lang.rust-analyzer",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "eamodio.gitlens",
      "github.vscode-github-actions",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ericsia.restoreterminals"
    ]
  }
}
